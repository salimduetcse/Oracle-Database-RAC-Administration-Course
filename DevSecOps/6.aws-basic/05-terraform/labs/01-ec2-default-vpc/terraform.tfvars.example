# Copy to terraform.tfvars and edit — DO NOT commit terraform.tfvars

aws_profile      = "aws-basic-lab"
aws_region       = "ap-southeast-1"
student_name     = "yourname"
instance_type    = "t3.micro"
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"
# allowed_http_cidr = "YOUR_PUBLIC_IP/32"  # optional; defaults to allowed_ssh_cidr
